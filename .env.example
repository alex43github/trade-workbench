BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4-flash
SQUARE_MONITOR_BASE_URL=

# Operator session and maintenance scheduling (server-only; use distinct random values in VPS /etc/trade-workbench.env)
OPERATOR_ACCESS_TOKEN=
OPERATOR_SESSION_SECRET=
MAINTENANCE_JOB_TOKEN=
# Legacy local-development compatibility only. Do not set this in production.
ADVISORY_JOB_TOKEN=
# Cron: POST /api/advisory/maintenance with Authorization: Bearer MAINTENANCE_JOB_TOKEN
WORKBENCH_BASE_URL=http://127.0.0.1:3000
WORKBENCH_STATE_FILE=/var/lib/trade-workbench/maintenance-state.json
BARK_BASE_URL=
# Optional alternative to BARK_BASE_URL: Bark device key plus optional server URL.
BARK_API_KEY=
BARK_SERVER_URL=https://api.day.app

# Local strong-coin structure radar (read-only, notifications off by default)
STRUCTURE_RADAR_BASE_URL=http://127.0.0.1:8790
RADAR_LOCAL_TOKEN=
RADAR_DATA_DIRECTORY=.data/structure-radar
RADAR_PORT=8790
RADAR_NOTIFY_ENABLED=false
# Optional local Clash HTTP proxy for the Node REST/WebSocket daemon.
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890
RADAR_BARK_CONFIG_PATH=/Users/your-name/Downloads/交易文档/binance-square-monitor/macos/config/mobile_push.json
RADAR_ICT_SKILL_PATH=/Users/your-name/.codex/skills/ict-trading/SKILL.md
RADAR_STREET_SKILL_PATH=/Users/your-name/.codex/skills/street-trading/SKILL.md
RADAR_JINGXIN_SKILL_PATH=/Users/your-name/.codex/skills/jingxin-trading/SKILL.md
RADAR_BITLANGLANG_SKILL_PATH=/Users/your-name/.codex/skills/bitlanglang-trading/SKILL.md

# 固定 IP 币安网关：同机 VPS 时仅走回环地址，禁止把 8788 暴露到公网。Token 至少 16 位。
BINANCE_GATEWAY_BASE_URL=http://127.0.0.1:8788
BINANCE_GATEWAY_TOKEN=

# Optional: a separate HTTPS deployment webhook. The browser can only request
# this fixed action; it never executes SSH, shell commands, or deployment scripts.
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_TOKEN=
APP_VERSION=
BUILD_ID=
