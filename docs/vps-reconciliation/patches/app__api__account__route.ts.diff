+  catch (error) { return NextResponse.json({ error: error instanceof Error ? error.message : "交易所参数不正确" }, { status: 400, headers: { "cache-control": "no-store" } }); }
+  if (requestedExchange === "BYBIT") {
+    try { return NextResponse.json(await bybitAccountSnapshot(), { headers: { "cache-control": "no-store" } }); }
+    catch { return NextResponse.json({ ...disconnected("Bybit 只读查询暂时不可用"), exchange: "BYBIT" as const }, { headers: { "cache-control": "no-store" } }); }
+  }
   const gateway = getGatewayConfig();
