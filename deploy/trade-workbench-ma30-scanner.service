[Unit]
Description=Trade Workbench MA30 full-market scanner
After=network-online.target binance-gateway.service
Wants=network-online.target binance-gateway.service

[Service]
Type=oneshot
User=trade-workbench
Group=trade-workbench
WorkingDirectory=/opt/trade-workbench
EnvironmentFile=/etc/trade-workbench/workbench.env
Environment=STREETLIGHT_LOCAL_D1=/var/lib/trade-workbench/sqlite/d1.sqlite
Environment=MA30_ENABLE_LIVE_BARK=YES
ExecStart=/usr/bin/node --experimental-strip-types --use-env-proxy /opt/trade-workbench/scripts/ma30-production-live-safe.ts --live
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trade-workbench
UMask=0077
