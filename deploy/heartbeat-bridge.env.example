# Never commit the real values.
HEARTBEAT_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec
HEARTBEAT_WEBHOOK_SECRET=REPLACE_WITH_64_HEX_SECRET

# Existing authoritative Focus V23 output on VPS:
HEARTBEAT_FOCUS_JSON=/var/lib/trade-workbench/structure-radar/hourly-focus-pool-v22.json

# Local authoritative/synced/pending receipts:
HEARTBEAT_STATE_DIR=/var/lib/trade-workbench/heartbeat-bridge

# Optional metadata fallback if current V23 JSON does not carry these fields:
HEARTBEAT_MODEL_VERSION=
HEARTBEAT_SCORE_VERSION=

HEARTBEAT_HTTP_TIMEOUT=10
HEARTBEAT_HTTP_ATTEMPTS=3
