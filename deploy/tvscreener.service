[Unit]
Description=Trade Workbench TradingView Screener sidecar (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trade-workbench
Group=trade-workbench
WorkingDirectory=/opt/trade-workbench
# Keep the sidecar independent from the main secret file. It has no Binance,
# Telegram, Bark, or trading credentials.
Environment=TVSCREENER_HOST=127.0.0.1
Environment=TVSCREENER_PORT=8791
Environment=TVSCREENER_BASE_URL=http://127.0.0.1:8791
ExecStart=/var/lib/trade-workbench/tvscreener-venv/bin/python /opt/trade-workbench/services/tvscreener/server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trade-workbench
UMask=0077

[Install]
WantedBy=multi-user.target
