[Unit]
Description=Trade Workbench web application
After=network-online.target binance-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=trade-workbench
Group=trade-workbench
WorkingDirectory=/opt/trade-workbench
EnvironmentFile=/etc/trade-workbench/workbench.env
Environment=WRANGLER_LOG_PATH=/var/lib/trade-workbench/wrangler.log
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trade-workbench
UMask=0077

[Install]
WantedBy=multi-user.target
