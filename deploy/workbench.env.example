# Install as /etc/trade-workbench/workbench.env with owner root:root and mode 0600.
# Never commit the installed file. Generate tokens with: openssl rand -hex 32
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Local SQLite is persistent data, not release data.
STREETLIGHT_LOCAL_D1=/var/lib/trade-workbench/sqlite/d1.sqlite
WORKBENCH_BASE_URL=http://127.0.0.1:3000
WORKBENCH_STATE_FILE=/var/lib/trade-workbench/maintenance-state.json
PAPER_STRATEGY_SCHEDULER_STATE_FILE=/var/lib/trade-workbench/paper-strategy-scheduler-state.json

# Distinct, long random values. These are server-only.
OPERATOR_ACCESS_TOKEN=replace-with-a-long-random-operator-token
OPERATOR_SESSION_SECRET=replace-with-a-different-long-random-session-secret
MAINTENANCE_JOB_TOKEN=replace-with-a-different-long-random-maintenance-token

# Keep the gateway on the same VPS and loopback only.
BINANCE_GATEWAY_BASE_URL=http://127.0.0.1:8788
BINANCE_GATEWAY_TOKEN=replace-with-a-different-long-random-gateway-token
BINANCE_GATEWAY_PORT=8788
BINANCE_GATEWAY_TRADING=false
# Separate application gate for real position close; keep false until API permissions, IP whitelist, and a dry review are complete.
WORKBENCH_LIVE_TRADING_ENABLED=false
# Read-only, withdrawal-free, IP-whitelisted credentials only. Leave blank if account data is not needed.
BINANCE_GATEWAY_API_KEY=
BINANCE_GATEWAY_API_SECRET=

# Telegram private trading bot. Keep these root-only; do not paste any into chat or browser fields.
# TELEGRAM_ALLOWED_USER_ID is your numeric Telegram user ID, not @username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_PATH=replace-with-a-long-random-webhook-path
TELEGRAM_WEBHOOK_SECRET=replace-with-a-different-long-random-webhook-secret
TELEGRAM_ALLOWED_USER_ID=

# Optional server-only providers and notifications.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4-flash
BARK_BASE_URL=
BARK_API_KEY=
BARK_SERVER_URL=https://api.day.app
SQUARE_MONITOR_BASE_URL=

# Structure radar stays loopback-only and notifications remain opt-in.
STRUCTURE_RADAR_BASE_URL=http://127.0.0.1:8790
RADAR_LOCAL_TOKEN=
RADAR_DATA_DIRECTORY=/var/lib/trade-workbench/structure-radar
RADAR_PORT=8790
RADAR_NOTIFY_ENABLED=false

# Optional TradingView research sidecar. It is loopback-only and advisory-only.
