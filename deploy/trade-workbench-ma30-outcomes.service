[Unit]
Description=Trade Workbench MA30 outcome backfill
After=network-online.target binance-gateway.service trade-workbench-ma30-scanner.service
Wants=network-online.target binance-gateway.service

[Service]
Type=oneshot
User=trade-workbench
Group=trade-workbench
WorkingDirectory=/opt/trade-workbench
EnvironmentFile=/etc/trade-workbench/workbench.env
Environment=STREETLIGHT_LOCAL_D1=/var/lib/trade-workbench/sqlite/d1.sqlite
ExecStart=/usr/bin/node --experimental-strip-types --use-env-proxy /opt/trade-workbench/scripts/ma30-outcome-backfill.ts
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trade-workbench
UMask=0077
