[Unit]
Description=Trade Workbench second ignition outcome backfill
After=network-online.target trade-workbench.service
Wants=network-online.target

[Service]
Type=oneshot
User=trade-workbench
Group=trade-workbench
WorkingDirectory=/opt/trade-workbench
EnvironmentFile=/etc/trade-workbench/workbench.env
ExecStart=/usr/bin/node --experimental-strip-types --use-env-proxy /opt/trade-workbench/scripts/second-ignition-outcome-backfill.ts
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trade-workbench
UMask=0077
