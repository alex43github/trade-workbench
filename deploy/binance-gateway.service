[Unit]
Description=Trade Workbench Binance fixed-IP gateway (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trade-workbench
Group=trade-workbench
WorkingDirectory=/opt/trade-workbench
EnvironmentFile=/etc/trade-workbench/workbench.env
# server.mjs binds internally to 127.0.0.1; this unit deliberately has no public listener.
ExecStart=/usr/bin/node /opt/trade-workbench/binance-gateway/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trade-workbench
UMask=0077

[Install]
WantedBy=multi-user.target
