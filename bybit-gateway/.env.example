# Copy to /opt/trade-workbench/bybit-gateway/.env with owner root:root and mode 0600.
# All credentials below are server-only. Generate the token with: openssl rand -hex 32
# Workbench calls this loopback listener; the gateway itself uses the separate upstream variable below.
BYBIT_GATEWAY_BASE_URL=http://127.0.0.1:8789
# Production Bybit API origin. The server accepts only HTTPS outside an explicitly enabled test fake.
BYBIT_GATEWAY_UPSTREAM_BASE_URL=https://api.bybit.com
BYBIT_GATEWAY_PORT=8789
BYBIT_GATEWAY_TOKEN=
BYBIT_GATEWAY_API_KEY=
BYBIT_GATEWAY_API_SECRET=
# Keep false until read-only checks, IP allowlisting and a dry review are complete.
BYBIT_GATEWAY_TRADING=false
