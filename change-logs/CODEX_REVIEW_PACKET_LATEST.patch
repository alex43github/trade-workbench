+  const cleanupOnExit = () => {
+    if (released) return;
+    released = true;
+    try { unlinkSync(path); } catch { /* best-effort cleanup during process exit */ }
+  };
+  process.once("exit", cleanupOnExit);
+  return async () => {
+    if (released) return;
+    released = true;
+    process.removeListener("exit", cleanupOnExit);
